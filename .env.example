# =========================================================
# AI PROVIDERS & MODELS CONFIGURATION
# =========================================================
# Provedor preferencial opcional: 'anthropic', 'deepseek', 'gemini' ou 'ollama'
# (Se vazio, segue a ordem de disponibilidade: Anthropic -> DeepSeek -> Gemini -> Ollama)
PRIMARY_AI_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=sua_chave_anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# DeepSeek
DEEPSEEK_API_KEY=sua_chave_deepseek
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001

# Ollama (Local ou VPS)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
PREFER_OLLAMA=false

# =========================================================
# SUPABASE CONFIGURATION
# =========================================================
# Pegue estas chaves em: Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# =========================================================
# GITHUB CONFIGURATION (Opcional)
# =========================================================
GITHUB_TOKEN=
